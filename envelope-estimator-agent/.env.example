# ============================================================================
# Envelope Estimator Agent - Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# --- AI APIs ---
ANTHROPIC_API_KEY=sk-ant-xxx          # Required: Claude API for vision + reasoning
OPENAI_API_KEY=sk-xxx                  # Required: For DDC-CWICR embedding search

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost                   # Qdrant server host
QDRANT_PORT=6333                        # Qdrant server port
QDRANT_COLLECTION=ddc_cwicr_en          # Language collection (en, de, es, fr, etc.)

# --- Email Monitoring (Optional) ---
IMAP_SERVER=imap.gmail.com              # IMAP server
IMAP_USERNAME=estimating@yourcompany.com
IMAP_PASSWORD=your-app-password         # Use app-specific password for Gmail

# --- Watched Folder (Optional) ---
WATCHED_FOLDER_PATH=                    # e.g., /home/user/plan_drops

# --- Your Company Info ---
COMPANY_NAME=Your Company Name
COMPANY_PHONE=(555) 123-4567
COMPANY_EMAIL=estimating@yourcompany.com
COMPANY_LICENSE=

# --- Financial Markups ---
OVERHEAD_PERCENT=0.10                   # 10% overhead
PROFIT_PERCENT=0.10                     # 10% profit

# --- Regional Settings ---
DDC_REGION=en                           # DDC-CWICR region (en=Toronto/USD)
CURRENCY=USD

# --- Phases ---
ENABLED_PHASES=1                        # 1 = Phase 1 only, 1,2 = both phases

# --- Output ---
OUTPUT_DIR=./output
LOG_LEVEL=INFO
