# QuickBooks Online OAuth2 credentials
# Get these from https://developer.intuit.com
QB_CLIENT_ID=your_client_id
QB_CLIENT_SECRET=your_client_secret

# OAuth2 tokens — obtain via Intuit OAuth 2.0 Playground
# https://developer.intuit.com/app/developer/playground
QB_REFRESH_TOKEN=your_refresh_token
QB_ACCESS_TOKEN=

# Your QuickBooks company (realm) ID
# Find this in the URL when logged into QuickBooks Online:
#   https://app.qbo.intuit.com/app/homepage?companyId=YOUR_COMPANY_ID
QB_COMPANY_ID=your_company_id

# Environment: "sandbox" or "production"
QB_ENVIRONMENT=sandbox
